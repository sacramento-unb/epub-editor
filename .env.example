# Copie para .env e ajuste. Nunca versione o .env.

# Segredo externo ao banco usado para cifrar chaves de API e senhas de PDF salvas (mín. 16 caracteres).
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

POSTGRES_PASSWORD=epub-local

# Optional Gemini comparison during conversion.
# (A chave também pode ser cadastrada na tela "Configurações de IA"; fica cifrada no servidor.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PAGES_PER_CALL=40
GEMINI_MAX_CALLS=20

# Ollama (IA local). No Docker, o Ollama do host é acessado por host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
# Hosts permitidos para o endereço do Ollama (administrado aqui, não pela interface).
OLLAMA_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,ollama

# Limites de importação/processamento
MAX_UPLOAD_MB=200
MAX_PAGES=2000
OCR_LANGUAGES=por+eng
OCR_DPI=300
WORKER_CPUS=4
# processos de leitura de páginas (padrão: min(4, CPUs do contêiner))
EXTRACT_WORKERS=
WORKER_MEMORY=4g

# Portas locais (expostas apenas em 127.0.0.1)
WEB_PORT=3000
API_PORT=8000
