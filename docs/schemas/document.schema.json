{
  "$comment": "modelo documental intermediário (schema_version 1)",
  "$defs": {
    "Element": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "heading",
            "paragraph",
            "list_item",
            "blockquote",
            "image",
            "figure",
            "caption",
            "table",
            "formula",
            "footnote",
            "header",
            "footer",
            "page_number",
            "toc",
            "cover",
            "decoration",
            "watermark",
            "region"
          ],
          "title": "Type",
          "type": "string"
        },
        "subtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtype"
        },
        "text_original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Original"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "marks": {
          "items": {
            "$ref": "#/$defs/InlineMark"
          },
          "title": "Marks",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRegion"
          },
          "title": "Sources",
          "type": "array"
        },
        "level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "chapter_break": {
          "default": false,
          "title": "Chapter Break",
          "type": "boolean"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "included": {
          "default": true,
          "title": "Included",
          "type": "boolean"
        },
        "excluded_explicit": {
          "default": false,
          "title": "Excluded Explicit",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "observed_style": {
          "$ref": "#/$defs/ObservedStyle"
        },
        "output_style": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Output Style",
          "type": "object"
        },
        "asset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset"
        },
        "caption_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption Id"
        },
        "alt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt"
        },
        "note_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note Id"
        },
        "table": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "$ref": "#/$defs/TableCell"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "mathml": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mathml"
        },
        "extraction": {
          "$ref": "#/$defs/Extraction"
        },
        "review": {
          "items": {
            "type": "string"
          },
          "title": "Review",
          "type": "array"
        },
        "provenance": {
          "items": {
            "type": "string"
          },
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Element",
      "type": "object"
    },
    "Extraction": {
      "properties": {
        "method": {
          "default": "native",
          "enum": [
            "native",
            "ocr",
            "manual",
            "derived",
            "ai"
          ],
          "title": "Method",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "title": "Extraction",
      "type": "object"
    },
    "InlineMark": {
      "description": "Marca inline sobre ``text`` (offsets de caractere).",
      "properties": {
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "bold",
            "italic",
            "sup",
            "sub",
            "link",
            "noteref"
          ],
          "title": "Kind",
          "type": "string"
        },
        "href": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Href"
        }
      },
      "required": [
        "start",
        "end",
        "kind"
      ],
      "title": "InlineMark",
      "type": "object"
    },
    "Metadata": {
      "properties": {
        "title": {
          "default": "Sem título",
          "title": "Title",
          "type": "string"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "language": {
          "default": "pt-BR",
          "title": "Language",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "identifier": {
          "default": "",
          "title": "Identifier",
          "type": "string"
        },
        "direction": {
          "default": "ltr",
          "enum": [
            "ltr",
            "rtl"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "ObservedStyle": {
      "properties": {
        "font": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font"
        },
        "size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "bold": {
          "default": false,
          "title": "Bold",
          "type": "boolean"
        },
        "italic": {
          "default": false,
          "title": "Italic",
          "type": "boolean"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "align": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Align"
        }
      },
      "title": "ObservedStyle",
      "type": "object"
    },
    "PageInfo": {
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "width": {
          "title": "Width",
          "type": "number"
        },
        "height": {
          "title": "Height",
          "type": "number"
        },
        "rotation": {
          "default": 0,
          "title": "Rotation",
          "type": "integer"
        },
        "mediabox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Mediabox",
          "type": "array"
        },
        "cropbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Cropbox",
          "type": "array"
        },
        "kind": {
          "default": "digital",
          "enum": [
            "digital",
            "scanned",
            "mixed",
            "empty"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ocr_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Confidence"
        },
        "ocr_lang": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Lang"
        }
      },
      "required": [
        "index",
        "width",
        "height",
        "mediabox",
        "cropbox"
      ],
      "title": "PageInfo",
      "type": "object"
    },
    "SourceRegion": {
      "properties": {
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "coord": {
          "const": "page_display_pt",
          "default": "page_display_pt",
          "title": "Coord",
          "type": "string"
        }
      },
      "required": [
        "page",
        "bbox"
      ],
      "title": "SourceRegion",
      "type": "object"
    },
    "TableCell": {
      "properties": {
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "header": {
          "default": false,
          "title": "Header",
          "type": "boolean"
        },
        "rowspan": {
          "default": 1,
          "title": "Rowspan",
          "type": "integer"
        },
        "colspan": {
          "default": 1,
          "title": "Colspan",
          "type": "integer"
        }
      },
      "title": "TableCell",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageInfo"
      },
      "title": "Pages",
      "type": "array"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/Element"
      },
      "title": "Elements",
      "type": "array"
    },
    "global_style": {
      "additionalProperties": true,
      "title": "Global Style",
      "type": "object"
    },
    "outline": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Outline",
      "type": "array"
    },
    "doc_kind": {
      "default": "digital",
      "enum": [
        "digital",
        "scanned",
        "mixed",
        "empty"
      ],
      "title": "Doc Kind",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "title": "Document",
  "type": "object"
}